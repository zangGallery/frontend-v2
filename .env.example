# Base RPC endpoint. Defaults to the free Tenderly public gateway if unset.
# Must support eth_getLogs over multi-million block ranges — most free RPCs
# don't. Run `node scripts/test-base-rpcs.mjs` to check which endpoints qualify.
# VITE_BASE_RPC_URL=https://base.gateway.tenderly.co   # client-side
# BASE_RPC_URL=https://base.gateway.tenderly.co        # server-side

# Ethereum mainnet RPC for ENS resolution. Defaults to PublicNode if unset.
# VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional: Alchemy API keys. Used only when the RPC URL overrides above are
# not set. An explicit *_RPC_URL always takes precedence.
# VITE_ALCHEMY_BASE_API_KEY=your_alchemy_base_api_key_here
# VITE_ALCHEMY_MAINNET_API_KEY=your_alchemy_mainnet_api_key_here
# ALCHEMY_BASE_API_KEY=your_alchemy_base_api_key_here

# Optional: Site URL for OpenGraph tags (defaults to https://zang.gallery)
SITE_URL=https://zang.gallery

# Server port (Railway sets this automatically)
PORT=3000
